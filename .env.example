# ============================================
# Todo List Application - Environment Template
# ============================================
# Copy this file to `.env` and adjust values as needed.
# NEVER commit the actual `.env` file to version control.

# --- MySQL Container Configuration ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=todo_user
MYSQL_PASSWORD=todo_password
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=todo_db

# --- Unified Database Connection String ---
# Format: mysql://user:password@host:port/database
# Used by lib/db.ts for connection pooling.
# For local Docker MySQL:
DATABASE_URL=mysql://todo_user:todo_password@localhost:3306/todo_db

# --- For remote/cloud MySQL, replace with your cloud endpoint ---
# Example (AWS RDS / GCP Cloud SQL / PlanetScale):
# DATABASE_URL=mysql://username:password@your-cloud-host:3306/your_database